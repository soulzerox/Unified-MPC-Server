# ==============================================================================
# Unified-MPC Server Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Never commit the resulting .env file.
# ==============================================================================

# WARNING: Unrestricted mode intentionally exposes every local directory to
# Unified-MPC's workspace/capability boundary. Destructive operations are still
# centrally gated, but this is a high-trust local-agent configuration.
UNIFIED_MPC_UNRESTRICTED=1

# Storage & Data Paths (POSIX XDG default: ~/.local/share/unified-mpc)
# UNIFIED_MPC_DATA_PATH=/home/user/.local/share/unified-mpc

# Optional: start/select a specific workspace on startup.
# UNIFIED_MPC_WORKSPACE=/home/user/projects/my-app

# Optional: colon-separated extra capability roots.
# UNIFIED_MPC_CAPABILITY_ROOTS=/home/user/projects:/mnt/workspace_data

# Optional loopback Streamable HTTP MCP port.
# Default: 18765. If the preferred bind is unavailable, the runtime may fall
# back to an ephemeral loopback port and report the actual URL in the UI.
# UNIFIED_MPC_PORT=18765

# Legacy ChatGPT/Web MCP transport sessions expire after one hour of inactivity by default.
# Activity refreshes this transport TTL; durable goals/checkpoints/worktrees are not deleted.
# UNIFIED_MPC_LEGACY_SESSION_TTL_MS=3600000

# Cloudflare Quick Tunnel. Requires `cloudflared` in PATH (or set the binary).
# Gateway refuses to report healthy until MCP identity responds through tunnel.
# UNIFIED_MPC_CLOUDFLARED_BIN=/usr/local/bin/cloudflared

# Bootstrap-only non-secret tunnel metadata. Store tunnel token in Linux Secret
# Service through the Web Control Plane; never put token in this file.
# The public URL must point to this MCP server's `/mcp` endpoint.
# UNIFIED_MPC_CLOUDFLARE_TUNNEL_NAME=unified-mpc
# UNIFIED_MPC_CLOUDFLARE_PUBLIC_URL=https://mcp.example.com
# Use POST /api/settings with {"tunnelToken":"..."} once Secret Service is available.

# Web Control Plane Dashboard Port. Default: 3000.
# UNIFIED_MPC_WEB_PORT=3000

# Logging Level (debug, info, warn, error)
# UNIFIED_MPC_LOG_LEVEL=info

# Node Environment (development / production)
NODE_ENV=development
