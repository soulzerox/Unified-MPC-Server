{
  "name": "@unified-mpc/cli",
  "version": "4.61.0",
  "private": true,
  "type": "module",
  "bin": {
    "unified-mpc": "./dist/index.js",
    "unified-mcp": "./dist/index.js",
    "unified-mpc-mcp-http": "./dist/bin/mcp-http.js"
  },
  "dependencies": {
    "@unified-mpc/application": "workspace:*",
    "@unified-mpc/audit": "workspace:*",
    "@unified-mpc/capabilities": "workspace:*",
    "@unified-mpc/codex": "workspace:*",
    "@unified-mpc/domain": "workspace:*",
    "@unified-mpc/extensions": "workspace:*",
    "@unified-mpc/mcp-server": "workspace:*",
    "@unified-mpc/permissions": "workspace:*",
    "@unified-mpc/shared": "workspace:*",
    "@unified-mpc/storage": "workspace:*",
    "@unified-mpc/thai-rag": "workspace:*",
    "@unified-mpc/workspace": "workspace:*",
    "@unified-mpc/web": "workspace:*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "corepack pnpm --filter @unified-mpc/cli^... build && tsc --outDir dist && node ../../scripts/generate-build-provenance.mjs dist/build-provenance.json"
