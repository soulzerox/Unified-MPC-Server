# Copy to ~/.config/unified-mpc/service.env and replace every example path.
# systemd EnvironmentFile values are literal; do not use $HOME or ~ here.
UNIFIED_MPC_ROOT=/absolute/path/to/Unified-MPC-Server
UNIFIED_MPC_WORKSPACE=/absolute/path/to/your/project

# Inactive legacy Web MCP transport sessions default to one hour.
UNIFIED_MPC_LEGACY_SESSION_TTL_MS=3600000

# Keep ~/.local/bin so the Web control plane can spawn cloudflared.
# If Node is installed with nvm/asdf/mise, add that exact bin directory before /usr/bin.
PATH=/home/you/.local/bin:/usr/local/bin:/usr/bin:/bin
