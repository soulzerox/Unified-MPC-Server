[Unit]
Description=Unified-MPC-Server compatibility aggregate
Documentation=https://github.com/soulzerox/Unified-MPC-Server
Requires=unified-mpc-mcp-http.service unified-mpc-web.service
After=unified-mpc-mcp-http.service unified-mpc-web.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes

[Install]
WantedBy=default.target
